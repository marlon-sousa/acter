{
  "on_start": [
    {
      "payload": {
        "marker": {
          "kind": "A"
        }
      }
    },
    {
      "payload": {
        "text": "acter> "
      }
    },
    {
      "payload": {
        "marker": {
          "kind": "B"
        }
      }
    }
  ],
  "rules": [
    {
      "match": "small",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 100,
            "max_ms": 100
          },
          "payload": {
            "text": "hello from acter\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "big",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 100,
            "max_ms": 100
          },
          "payload": {
            "text": "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7\r\nline 8\r\nline 9\r\nline 10\r\nline 11\r\nline 12\r\nline 13\r\nline 14\r\nline 15\r\nline 16\r\nline 17\r\nline 18\r\nline 19\r\nline 20\r\nline 21\r\nline 22\r\nline 23\r\nline 24\r\nline 25\r\nline 26\r\nline 27\r\nline 28\r\nline 29\r\nline 30\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "fail",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 100,
            "max_ms": 100
          },
          "payload": {
            "text": "error: the command reported a problem\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 2
            }
          }
        }
      ]
    },
    {
      "match": "slow",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "text": "phase one\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "text": "phase two\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "text": "phase three\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "forever",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "text": "phase one\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 1000,
            "max_ms": 1000
          },
          "payload": {
            "text": "phase two\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 250,
            "max_ms": 250
          },
          "payload": {
            "text": "still working\r\n"
          },
          "repeat": "forever"
        }
      ]
    },
    {
      "match": "nano",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 300,
            "max_ms": 300
          },
          "payload": {
            "text": "\u001b[?1049h\u001b[H\u001b[2J  GNU nano 7.2\r\nediting a file\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 5000,
            "max_ms": 5000
          },
          "payload": {
            "text": "\u001b[?1049l"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "tail",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 3000,
            "max_ms": 8000
          },
          "payload": {
            "text": "tail line\r\n"
          },
          "repeat": 10
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "burst",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 300,
            "max_ms": 300
          },
          "payload": {
            "text": "line 1\r\nline 2\r\nline 3\r\nline 4\r\nline 5\r\nline 6\r\nline 7\r\nline 8\r\nline 9\r\nline 10\r\nline 11\r\nline 12\r\nline 13\r\nline 14\r\nline 15\r\nline 16\r\nline 17\r\nline 18\r\nline 19\r\nline 20\r\nline 21\r\nline 22\r\nline 23\r\nline 24\r\nline 25\r\nline 26\r\nline 27\r\nline 28\r\nline 29\r\nline 30\r\nline 31\r\nline 32\r\nline 33\r\nline 34\r\nline 35\r\nline 36\r\nline 37\r\nline 38\r\nline 39\r\nline 40\r\n"
          }
        },
        {
          "delay": {
            "min_ms": 3000,
            "max_ms": 8000
          },
          "payload": {
            "text": "trickle\r\n"
          },
          "repeat": 4
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "speech",
      "steps": [
        {
          "payload": {
            "marker": {
              "kind": "C"
            }
          }
        },
        {
          "delay": {
            "min_ms": 100,
            "max_ms": 100
          },
          "payload": {
            "text": "long announcement starting. word 1 word 2 word 3 word 4 word 5 word 6 word 7 word 8 word 9 word 10 word 11 word 12 word 13 word 14 word 15 word 16 word 17 word 18 word 19 word 20 word 21 word 22 word 23 word 24 word 25 word 26 word 27 word 28 word 29 word 30 word 31 word 32 word 33 word 34 word 35 word 36 word 37 word 38 word 39 word 40 word 41 word 42 word 43 word 44 word 45 word 46 word 47 word 48 word 49 word 50 word 51 word 52 word 53 word 54 word 55 word 56 word 57 word 58 word 59 word 60. long announcement finished\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D",
              "exit_code": 0
            }
          }
        }
      ]
    },
    {
      "match": "stop",
      "interrupts": true,
      "steps": [
        {
          "payload": {
            "text": "^C\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D"
            }
          }
        }
      ]
    },
    {
      "match": "\u0003",
      "interrupts": true,
      "steps": [
        {
          "payload": {
            "text": "^C\r\n"
          }
        },
        {
          "payload": {
            "marker": {
              "kind": "D"
            }
          }
        }
      ]
    }
  ],
  "default": {
    "steps": [
      {
        "payload": {
          "marker": {
            "kind": "C"
          }
        }
      },
      {
        "payload": {
          "marker": {
            "kind": "D",
            "exit_code": 0
          }
        }
      }
    ]
  }
}
